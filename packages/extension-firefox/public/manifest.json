{
  "manifest_version": 2,
  "name": "FCast Web Sender",
  "version": "0.1.0",
  "description": "Send explicitly selected web media to a trusted local FCast receiver.",
  "permissions": ["activeTab", "nativeMessaging", "storage"],
  "background": { "scripts": ["dist/background.js"], "persistent": false },
  "browser_action": { "default_title": "Send to FCast", "default_popup": "popup.html" },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "applications": { "gecko": { "id": "fcast-web-sender@caniko.com", "strict_min_version": "115.0" } }
}
