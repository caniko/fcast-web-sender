{
  "manifest_version": 3,
  "name": "FCast Web Sender",
  "version": "0.2.0",
  "key": "",
  "description": "Send explicitly selected web media to a trusted local FCast receiver.",
  "homepage_url": "https://github.com/caniko/fcast-web-sender",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage", "webRequest", "cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Send to FCast",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "options_page": "settings.html"
}
