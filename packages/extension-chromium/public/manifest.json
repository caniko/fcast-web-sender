{
  "manifest_version": 3,
  "name": "FCast Web Sender",
  "version": "0.1.0",
  "key": "",
  "description": "Send explicitly selected web media to a trusted local FCast receiver.",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage", "webRequest", "cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_title": "Send to FCast", "default_popup": "popup.html" },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "options_page": "settings.html"
}
